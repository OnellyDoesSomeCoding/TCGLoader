# Copy this file to `.env` and fill in the values.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# Neon Postgres connection string (Neon dashboard → Connect → "Pooled connection").
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Secret used to sign login sessions. Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Liveblocks secret key (Liveblocks dashboard → your project → API keys → Secret key).
LIVEBLOCKS_SECRET_KEY="sk_dev_..."

# Vercel Blob read/write token (Vercel → Storage → your Blob store → .env.local tab).
# Create the Blob store with "public" access so uploaded images can be displayed.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
